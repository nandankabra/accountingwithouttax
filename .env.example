# Set these in the process environment. This file is documentation, not auto-loaded.
APP_ENV=development
ALLOWED_HOSTS=localhost,127.0.0.1
# For an existing PostgreSQL server instead of scripts/dev.py:
# PGHOST=127.0.0.1
# PGPORT=5432
# PGDATABASE=simplebooks
# PGUSER=simplebooks
# PGPASSWORD=provide-outside-source-control
# SECRET_KEY=generate-and-store-outside-source-control
SESSION_IDLE_SECONDS=1800

# Password recovery: development emails are files in .runtime/mail.
APP_PUBLIC_URL=http://127.0.0.1:8017
LOGIN_IP_LIMIT=2000
# Production requires APP_ENV=production, HTTPS origin, SECRET_KEY and SMTP.
# APP_PUBLIC_URL=https://books.your-domain.example
# EMAIL_HOST=your.smtp.provider
# EMAIL_PORT=587
# EMAIL_HOST_USER=provide-outside-source-control
# EMAIL_HOST_PASSWORD=provide-outside-source-control
# DEFAULT_FROM_EMAIL=Simple Books <no-reply@your-verified-domain.example>
# Encrypted backups: keep the key separately from backup storage.
# BACKUP_KEY_FILE=/etc/simplebooks/backup-key
# BACKUP_DIRECTORY=/var/backups/simplebooks
